// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  OWNER
  ADMIN
  SALES
  OPS
  SUPPORT
  READONLY
}

enum QuoteStatus {
  DRAFT
  NEW
  NEEDS_INFO
  PRICING
  SENT
  APPROVED
  REJECTED
  EXPIRED
  ORDERED
  // Legacy statuses for backward compatibility
  SUBMITTED
  IN_REVIEW
  ACCEPTED
}

enum OrderStatus {
  PENDING_DEPOSIT
  IN_PRODUCTION
  QA
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  password          String? // hashed
  emailVerified     DateTime?
  image             String?
  role              UserRole  @default(CUSTOMER)
  isActive          Boolean   @default(true)
  companyId         String?
  company           Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  customPermissions String[]  // Permission overrides: '+users' to add, '-users' to remove
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  quotesCreated    Quote[]       @relation("QuoteCreator")
  ordersCreated    Order[]        @relation("OrderCreator")
  messages         Message[]
  quoteMessages    QuoteMessage[] @relation("QuoteMessageSender")
  invoices         Invoice[]
  auditLogs        AuditLog[]
  accounts         Account[]
  sessions         Session[]

  @@index([companyId])
  @@index([email])
  @@index([role])
  @@index([isActive])
}

model Company {
  id              String   @id @default(cuid())
  name            String
  address         String?
  city            String?
  state           String?
  country         String?
  postalCode      String?
  phone           String?
  website         String?
  taxId           String?
  billingAddress  String?  @db.Text
  shippingAddress String?  @db.Text
  notes           String?  @db.Text
  tags            String[] // For categorization
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  quotes          Quote[]
  orders          Order[]
  invoices        Invoice[]
  contacts        ClientContact[]

  @@index([name])
}

model ClientContact {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  email       String
  phone       String?
  roleTitle   String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotes      Quote[]  @relation("QuoteContact")

  @@index([companyId])
  @@index([email])
}

model Quote {
  id                String        @id @default(cuid())
  quoteNumber       String        @unique // Human-readable: QUOTE-2024-001
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId         String?       // Primary contact
  contact           ClientContact? @relation("QuoteContact", fields: [contactId], references: [id], onDelete: SetNull)
  createdById       String
  createdBy         User           @relation("QuoteCreator", fields: [createdById], references: [id])
  status            QuoteStatus   @default(NEW)
  
  // Form fields
  productCategory   String?
  productDescription String?
  targetCustomer    String?
  packagingType     String?
  labelingNeeds     String[] // JSON array
  estimatedQuantity String? // range like "1000-5000"
  targetUnitCost    Float?
  timeline          String?
  deadline          DateTime?
  targetDueDate     DateTime?     // Admin-set target
  shippingDestination String?
  
  // Flexible JSON data
  formData          Json? // For additional fields
  notesFromClient   String?        @db.Text
  internalNotes     String?       @db.Text // Admin-only
  
  // Admin response
  adminNotes        String?        @db.Text
  totalEstimate     Float?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  attachments       QuoteAttachment[]
  lineItems         QuoteLineItem[]
  messages          Message[]
  quoteMessages     QuoteMessage[]
  orders            Order[]

  @@index([companyId])
  @@index([createdById])
  @@index([status])
  @@index([quoteNumber])
  @@index([contactId])
}

model QuoteMessage {
  id            String   @id @default(cuid())
  quoteId       String
  quote         Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  senderType    String   // "ADMIN" | "CLIENT"
  senderUserId  String?  // If admin sent it
  senderUser    User?    @relation("QuoteMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  senderContactId String? // If client contact sent it
  message       String   @db.Text
  createdAt     DateTime @default(now())

  @@index([quoteId])
  @@index([senderUserId])
}

model QuoteAttachment {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  uploadedAt  DateTime @default(now())

  @@index([quoteId])
}

model QuoteLineItem {
  id            String   @id @default(cuid())
  quoteId       String
  quote         Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  listingId     String?  // Reference to Listing if from catalog
  listing       Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  variantId     String?  // Reference to ListingVariant
  variant       ListingVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  customTitle   String?  // If not from catalog
  description   String   // Fallback if no listing
  quantity      Int
  specs         Json?    // Flexible specs JSONB
  unitPrice     Float?
  lineTotal     Float?   // quantity * unitPrice
  totalPrice    Float?   // Legacy alias
  internalCost  Float?   // Admin-only cost tracking
  margin        Float?   // Calculated margin percentage
  notes         String?
  createdAt     DateTime @default(now())

  @@index([quoteId])
  @@index([listingId])
  @@index([variantId])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique // Human-readable: ORD-2024-001
  quoteId           String?     @unique // One-to-one: quote can only convert to one order
  quote             Quote?      @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  companyId         String
  company           Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById       String
  createdBy         User         @relation("OrderCreator", fields: [createdById], references: [id])
  status            OrderStatus  @default(PENDING_DEPOSIT)
  
  // Shipping
  shippingAddress   String?
  shippingCity      String?
  shippingState     String?
  shippingCountry   String?
  shippingPostalCode String?
  trackingNumber    String?
  
  // Financial
  subtotal          Float       @default(0)
  tax               Float       @default(0)
  shipping          Float       @default(0)
  total             Float       @default(0)
  depositPaid       Float       @default(0)
  balanceDue        Float       @default(0)
  
  // Dates
  estimatedShipDate DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  items             OrderItem[]
  messages          Message[]
  invoices          Invoice[]

  @@index([companyId])
  @@index([createdById])
  @@index([status])
  @@index([quoteId])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku           String?
  name          String
  description   String?
  quantity      Int
  unitPrice     Float
  totalPrice    Float
  packagingSpec String? // JSON
  createdAt     DateTime @default(now())

  @@index([orderId])
}

model Message {
  id          String   @id @default(cuid())
  quoteId     String?
  quote       Quote?   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     String
  isInternal  Boolean  @default(false) // Admin-only notes
  createdAt   DateTime @default(now())

  attachments Attachment[]

  @@index([quoteId])
  @@index([orderId])
  @@index([userId])
}

model Attachment {
  id          String   @id @default(cuid())
  messageId   String
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  uploadedAt  DateTime @default(now())

  @@index([messageId])
}

model Invoice {
  id                    String        @id @default(cuid())
  orderId               String?
  order                 Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  companyId             String
  company               Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById           String
  createdBy             User          @relation(fields: [createdById], references: [id])
  invoiceNumber         String        @unique
  status                InvoiceStatus @default(DRAFT)
  amount                Float
  tax                   Float         @default(0)
  total                 Float
  dueDate               DateTime?
  paidAt                DateTime?
  stripePaymentIntentId String?
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([orderId])
  @@index([companyId])
  @@index([status])
  @@index([invoiceNumber])
}

model Brand {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  parentId    String?
  parent      Brand?   @relation("BrandParent", fields: [parentId], references: [id])
  children    Brand[]  @relation("BrandParent")
  heroImage   String?
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]

  @@index([slug])
  @@index([parentId])
}

model Product {
  id            String   @id @default(cuid())
  brandId       String
  brand         Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name          String
  description   String?  @db.Text
  bullets       String[] @default([])
  category      String?  // e.g., "Coffee", "Hard Candies", "Sweeteners"
  imageUrl      String?
  amazonUrl     String?  // Legacy field, kept for backward compatibility
  asin          String?  // Made optional - not all products have ASINs
  sku           String?  // Generic SKU for non-Amazon products
  priceAmount   Float?
  priceCurrency String?  @default("USD")
  rating        Float?
  reviewCount   Int?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  lastSyncedAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  storeLinks    ProductStoreLink[]

  @@index([brandId])
  @@index([asin])
  @@index([sku])
  @@index([category])
  @@index([isActive])
}

// Store links for products (Amazon, Walmart, eBay, etc.)
model ProductStoreLink {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeName   String   // "Amazon", "Walmart", "eBay", "Target", etc.
  storeUrl    String   // The full URL to the product on that store
  storeId     String?  // Optional store-specific ID (ASIN, Walmart ID, etc.)
  price       Float?   // Optional price on this store
  isDefault   Boolean  @default(false) // Primary/default store link
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([storeName])
}

// Admin-managed product listings (separate from Brand products)
enum ListingStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  parentId    String?
  parent      Category? @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryParent")
  description String?  @db.Text
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listings    Listing[]

  @@index([slug])
  @@index([parentId])
}

model Listing {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  description   String?       @db.Text
  status        ListingStatus @default(DRAFT)
  categoryId    String?
  category      Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand         String?       // Brand name if applicable
  moq           Int?          // Minimum order quantity
  leadTimeDays  Int?          // Lead time in days
  basePrice     Float?        // Base price
  pricingModel  String?       // "unit", "tiered", "custom"
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  variants      ListingVariant[]
  media         ListingMedia[]
  quoteLineItems QuoteLineItem[]

  @@index([slug])
  @@index([status])
  @@index([categoryId])
}

model ListingVariant {
  id            String   @id @default(cuid())
  listingId     String
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sku           String
  option1Name   String?  // e.g., "Size"
  option1Value  String?  // e.g., "Large"
  option2Name   String?  // e.g., "Color"
  option2Value  String?  // e.g., "Blue"
  cost          Float?   // Internal cost
  price         Float?   // Customer-facing price
  moq           Int?     // Variant-specific MOQ
  leadTimeDays  Int?     // Variant-specific lead time
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  quoteLineItems QuoteLineItem[]

  @@index([listingId])
  @@index([sku])
}

model ListingMedia {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url         String
  alt         String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([listingId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String   // "status_change", "created", "updated", "deleted", "pricing_edited", "role_changed"
  entityType  String   // "Quote", "Order", "Invoice", "Listing", "User", etc.
  entityId    String
  before      Json?    // Before state (JSONB)
  after       Json?    // After state (JSONB)
  ip          String?
  userAgent   String?
  metadata    Json?    // Additional context
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@index([action])
}

// NextAuth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────
// SUPPLIERS & LOT / BATCH TRACKER
// ─────────────────────────────────────────────────────────────

enum BatchLotStatus {
  INCOMING      // On the way
  RECEIVED      // Arrived at warehouse
  IN_QC         // Under quality control inspection
  APPROVED      // QC passed, cleared for use/sale
  ON_HOLD       // Flagged, awaiting decision
  RECALLED      // Recalled / pulled from use
  DISPOSED      // Discarded / destroyed
}

model Supplier {
  id            String   @id @default(cuid())
  name          String
  contactName   String?
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  country       String?
  website       String?
  notes         String?  @db.Text
  isActive      Boolean  @default(true)
  category      String   @default("SUPPLIER") // "SUPPLIER" | "PRIVATE_LABEL"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  batchLots     BatchLot[]
  masterBatches MasterBatch[]
  documents     ClientDocument[]

  @@index([name])
  @@index([isActive])
  @@index([category])
}

model BatchLot {
  id              String          @id @default(cuid())
  supplierId      String
  supplier        Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  // Identification
  lotNumber       String          // e.g. "LOT-2024-001", vaccine-style batch number
  productName     String
  productSku      String?
  category        String?

  // Quantities
  quantityReceived Int?
  quantityUnit    String?         // "units", "lbs", "kg", "boxes", "pallets"

  // Dates & Timestamps
  manufacturedAt  DateTime?
  expiresAt       DateTime?
  receivedAt      DateTime        @default(now())
  approvedAt      DateTime?

  // Status & Tracking
  status          BatchLotStatus  @default(INCOMING)
  internalNotes   String?         @db.Text
  qcNotes         String?         @db.Text
  recallReason    String?         @db.Text

  masterBatchId   String?
  masterBatch     MasterBatch?    @relation(fields: [masterBatchId], references: [id], onDelete: SetNull)

  // Financial
  unitCost        Float?
  totalCost       Float?
  invoiceNumber   String?
  poNumber        String?         // Purchase Order number

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  attachments     BatchLotAttachment[]

  @@index([supplierId])
  @@index([lotNumber])
  @@index([status])
  @@index([receivedAt])
  @@index([productName])
  @@index([masterBatchId])
}

model MasterBatch {
  id              String          @id @default(cuid())
  supplierId      String
  supplier        Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  
  // Shared identification
  name            String?         // e.g. "Mixed Pallet #1", "Weekly Delivery"
  invoiceNumber   String?
  poNumber        String?
  receivedAt      DateTime        @default(now())
  notes           String?         @db.Text
  
  // Relations
  batchLots       BatchLot[]
  attachments     MasterBatchAttachment[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([supplierId])
  @@index([invoiceNumber])
  @@index([poNumber])
}

model MasterBatchAttachment {
  id              String    @id @default(cuid())
  masterBatchId   String
  masterBatch     MasterBatch @relation(fields: [masterBatchId], references: [id], onDelete: Cascade)
  fileName        String
  fileUrl         String
  fileSize        Int?
  mimeType        String?
  label           String?
  uploadedAt      DateTime  @default(now())

  @@index([masterBatchId])
}

model BatchLotAttachment {
  id          String    @id @default(cuid())
  batchLotId  String
  batchLot    BatchLot  @relation(fields: [batchLotId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  label       String?   // "Pallet Photo", "Invoice", "COA", "Label", "Other"
  uploadedAt  DateTime  @default(now())

  @@index([batchLotId])
}

// Site settings for admin-editable content
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  label     String?  // Human-readable label for admin UI
  type      String   @default("text") // "text", "email", "phone", "url", "textarea"
  group     String   @default("general") // "contact", "social", "general"
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
  @@index([key])
}

// Documents uploaded for Private Label clients
model ClientDocument {
  id          String   @id @default(cuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name        String   // Custom name given by user
  fileUrl     String   @db.Text
  fileName    String   // Original filename
  fileSize    Int?
  mimeType    String?
  uploadedAt  DateTime @default(now())

  @@index([supplierId])
}
// ─────────────────────────────────────────────────────────────
// FBA SHIPMENTS
// ─────────────────────────────────────────────────────────────

enum FbaShipmentStatus {
  ACTIVE
  CLOSED
}

enum FbaShipmentItemStatus {
  IN_SHIPMENT
  PENDING
}

model FbaShipment {
  id        String   @id @default(cuid())
  name      String
  status    FbaShipmentStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     FbaShipmentItem[]
}

model FbaShipmentItem {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    FbaShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      FbaShipmentItemStatus @default(IN_SHIPMENT)

  location    String?
  boxOrder    String?
  name        String?
  fnsku       String?
  sku         String?
  upc         String?
  asin        String?
  qtyPerBox   Int?
  totalBoxes  Int?
  totalUnits  Int?
  expDate     String?
  length      Float?
  width       Float?
  height      Float?
  boxWeight   Float?
  description String?
  imageUrl    String?
  imageUrls   String[] @default([])
  sortOrder   Int @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([shipmentId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// MACHINE SETUPS BY PRODUCT
// ─────────────────────────────────────────────────────────────

model MachineSetup {
  id                      String   @id @default(cuid())
  productName             String
  weightGrams             String?  // e.g. "500g"
  description             String?  @db.Text
  bagSize                 String?  // e.g. "200mm"
  presetSpeed             String?  // e.g. "45/min"
  actualSpeed             String?  // e.g. "22min"
  additionalChanges       String?  @db.Text
  
  // Multiple images as requested in the screenshot
  productImageUrl         String?  // Picture of Product
  weightingImageUrl       String?  // Picture of weighting machine
  packagingImageUrl       String?  // picture of packaging machine
  parametersImageUrl      String?  // Parameters of packaging (screen)
  
  imageUrls               String[] @default([]) // Dynamic list of image links/uploads
  
  sortOrder               Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([productName])
}

// CLEANING LOGS
// ─────────────────────────────────────────────────────────────

model CleaningLog {
  id                String   @id @default(cuid())
  date              DateTime @default(now())
  time              String?  // e.g. "10:30 AM"
  areaCleaned       String?
  tasksCompleted    String?  @db.Text
  cleanedBy         String?
  supervisorInitials String?
  notes             String?  @db.Text
  imageUrls         String[] @default([])
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([date])
}
// ─────────────────────────────────────────────────────────────
// WAREHOUSE RACK MAP / PALLET INVENTORY
// ─────────────────────────────────────────────────────────────

model WarehousePallet {
  id                String   @id @default(cuid())
  locationCode      String   // e.g. "A1T", "B5P" — no longer unique, supports mixed pallets
  
  rack              String   // "A", "B", "C", "FLOOR-A", "FLOOR-B", "FLOOR-C"
  level             String   // "TOP", "MID", "BOT", "FLOOR"
  cellNumber        Int      // 1-8 for rack A, 1-5 for B/C
  palletPosition    Int      // 1 or 2

  sku               String?
  productName       String?
  quantity          Int?
  lotNumber         String?
  expirationDate    DateTime?
  palletHeightIn    Float?   // height in inches
  status            String   @default("AVAILABLE") // AVAILABLE, RESERVED, DAMAGED, HOLD, INBOUND, OUTBOUND
  notes             String?  @db.Text

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([rack])
  @@index([status])
  @@index([sku])
  @@index([locationCode])
}

// ─────────────────────────────────────────────────────────────
// INVENTORY (Amazon-synced + manual warehouse items)
// ─────────────────────────────────────────────────────────────

enum InventorySource {
  AMAZON
  MANUAL
}

model InventoryItem {
  id              String          @id @default(cuid())
  source          InventorySource @default(MANUAL)

  // Amazon fields
  asin            String?
  fnsku           String?         // Fulfillment Network SKU
  amazonTitle     String?
  amazonImageUrl  String?
  amazonUrl       String?

  // Barcode identifiers
  upc             String?         // UPC barcode (12-digit)
  ean             String?         // EAN / IAN barcode (13-digit)

  // Common fields
  name            String
  sku             String?
  description     String?         @db.Text
  imageUrl        String?         // Manual image or override
  category        String?
  location        String?         // Warehouse location code

  // Inventory quantities
  quantityOnHand  Int             @default(0)
  quantityReserved Int            @default(0)
  reorderPoint    Int             @default(0)
  unitCost        Float?
  sellingPrice    Float?          // From Amazon Reports price column
  fulfillmentChannel String?      // AMAZON (FBA) or MERCHANT (FBM)

  // Status
  isActive        Boolean         @default(true)
  amazonStatus    String?         // From Amazon Status column (Active, Inactive, etc.)
  notes           String?         @db.Text

  // Sync metadata
  lastSyncedAt    DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([source])
  @@index([asin])
  @@index([sku])
  @@index([upc])
  @@index([ean])
  @@index([category])
  @@index([isActive])
  @@index([name])
}

// ─────────────────────────────────────────────────────────────
// SHIPMENT LOG (History of items shipped from warehouse → Amazon)
// ─────────────────────────────────────────────────────────────

model ShipmentLog {
  id              String   @id @default(cuid())
  
  // Reference to the FBA shipment
  shipmentId      String
  shipmentName    String
  
  // Product info snapshot at time of shipment
  productName     String
  sku             String?
  asin            String?
  fnsku           String?
  upc             String?
  
  // Quantities shipped
  totalUnits      Int      @default(0)
  totalBoxes      Int?
  qtyPerBox       Int?
  
  // Warehouse location the product was shipped FROM
  locationCode    String?    // e.g. "A3T + A4T"
  
  // Status
  action          String     @default("SHIPPED") // SHIPPED, RETURNED, etc.
  notes           String?    @db.Text
  
  shippedAt       DateTime   @default(now())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([shipmentId])
  @@index([sku])
  @@index([shippedAt])
  @@index([productName])
}

// ─────────────────────────────────────────────────────────────
// AMAZON PRICE INTELLIGENCE (AUTOPRICER)
// ─────────────────────────────────────────────────────────────

model MonitoredProduct {
  id                  String   @id @default(cuid())
  asin                String
  sku                 String
  marketplace         String   @default("US") // e.g. "US", "CA", "UK", "DE", etc.
  productName         String
  imageUrl            String?
  category            String?

  // Seller Financial & Pricing Boundaries
  currentPrice        Float
  unitCost            Float
  fulfillmentMethod   String   @default("FBA") // "FBA" | "FBM"
  minPrice            Float    // Floor acceptable price
  maxPrice            Float    // Ceiling acceptable price
  minMarginPercent    Float    @default(25.0) // Desired minimum net profit margin %
  referralFeePercent  Float    @default(15.0) // Amazon referral fee %
  fbaFee              Float    @default(0.0)  // Pick, pack, and ship fee

  // Status & Market Intelligence
  status              String   @default("ACTIVE") // "ACTIVE", "PAUSED", "ARCHIVED"
  currentBuyBoxPrice  Float?
  buyBoxWinRate       Float?
  competitorCount     Int?
  velocityDaily       Float?

  // Recommendation Engine State
  recommendedAction   String   @default("MAINTAIN") // "RAISE", "LOWER", "MAINTAIN", "NEEDS_REVIEW"
  recommendedPrice    Float?
  recommendationReason String? @db.Text
  confidenceScore     Int?
  lastAnalyzedAt      DateTime?

  // Keepa & Target Rank Corridor Settings
  targetRankMin       Int      @default(1500)
  targetRankMax       Int      @default(3000)
  warningRank         Int      @default(4000)
  criticalRank        Int      @default(6000)
  defaultAdjustmentSize Float  @default(0.10)
  maxAdjustmentSize   Float    @default(0.50)
  cooldownHours       Int      @default(24)
  refreshIntervalHours Int     @default(6)

  // Keepa Sync Status
  keepaLastSyncedAt   DateTime?
  keepaSyncStatus     String?  // "SUCCESS", "ERROR", "PENDING"
  keepaTokensConsumed Int?

  // Autopilot Engine Tracking
  isAutopilot         Boolean  @default(false)
  autopilotStartedAt  DateTime?
  autopilotStartRank  Int?
  autopilotStartPrice Float?

  // Automatic Price Cycle Fields (Recurring Flash Sales)
  priceCycleEnabled        Boolean   @default(false)
  priceCycleStatus         String?   @default("Draft") // "Active", "Paused", "Failed", "Completed", "Draft"
  priceCycleDiscountPct    Float?    // e.g. 10 for 10%
  priceCycleRegularDays    Int?      // e.g. 14
  priceCycleDiscountDays   Int?      // e.g. 7
  priceCycleBasePrice      Float?    // e.g. 12.99
  priceCycleStartDate      DateTime? // When the cycle initially started
  priceCycleCurrentPhase   String?   // "REGULAR" | "DISCOUNT"
  priceCycleNextChangeAt   DateTime? // When the next phase shift happens

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  priceHistory        PriceChangeLog[]
  keepaHistory        KeepaProductHistory[]
  keepaEvaluations    KeepaEvaluationJob[]
  amazonDailySales    AmazonDailySales[]

  @@index([asin])
  @@index([sku])
  @@index([marketplace])
  @@index([status])
  @@index([recommendedAction])
}

model PriceChangeLog {
  id                  String   @id @default(cuid())
  monitoredProductId  String
  monitoredProduct    MonitoredProduct @relation(fields: [monitoredProductId], references: [id], onDelete: Cascade)

  oldPrice            Float
  newPrice            Float
  recommendedAction   String   // "RAISE", "LOWER", "MAINTAIN", "MANUAL"
  reason              String?  @db.Text
  status              String   @default("PENDING_APPROVAL") // "PENDING_APPROVAL", "APPROVED", "REJECTED", "APPLIED"

  // Temporary & Scheduled Approvals
  isTemporary         Boolean  @default(false)
  expiresAt           DateTime?
  restorePrice        Float?
  scheduledFor        DateTime?
  isRestored          Boolean  @default(false)

  requestedAt         DateTime @default(now())
  approvedAt          DateTime?
  approvedByUserId    String?
  notes               String?  @db.Text

  @@index([monitoredProductId])
  @@index([status])
  @@index([requestedAt])
}

model KeepaConfig {
  id                  String   @id @default("default_keepa_config")
  apiKey              String?  @db.Text // Encrypted API key
  tokensLeft          Int?     @default(300)
  refillRate          Int?     @default(12) // Tokens per minute
  lastCheckedAt       DateTime?
  connectionStatus    String?  // "CONNECTED", "ERROR", "TEST_MODE"
  auditLogs           String?  @db.Text // JSON string of recent API checks/consumption
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model KeepaProductHistory {
  id                  String   @id @default(cuid())
  monitoredProductId  String
  monitoredProduct    MonitoredProduct @relation(fields: [monitoredProductId], references: [id], onDelete: Cascade)
  asin                String
  timestamp           DateTime // Normalized UTC timestamp
  keepaTimestamp      Int      // Original Keepa minutes elapsed since Jan 1, 2011
  
  // Historical data streams (from Keepa CSV indices)
  salesRank           Int?     // Index 3
  buyBoxPrice         Float?   // Index 18
  amazonPrice         Float?   // Index 0
  newPrice            Float?   // Index 1
  newFbaPrice         Float?   // Index 10
  newFbmPrice         Float?   // Index 7
  offerCount          Int?     // Index 11
  
  // Filtering distorted data
  isAvailable         Boolean  @default(true)
  isExcluded          Boolean  @default(false)
  exclusionReason     String?  // "LIGHTNING_DEAL", "PRIME_DAY", "OUT_OF_STOCK", "LOST_BUY_BOX", etc.

  createdAt           DateTime @default(now())

  @@unique([monitoredProductId, keepaTimestamp])
  @@index([monitoredProductId, timestamp])
  @@index([asin, timestamp])
}

model KeepaEvaluationJob {
  id                  String   @id @default(cuid())
  monitoredProductId  String
  monitoredProduct    MonitoredProduct @relation(fields: [monitoredProductId], references: [id], onDelete: Cascade)
  priceChangeLogId    String?  
  
  oldPrice            Float
  newPrice            Float
  appliedAt           DateTime @default(now())
  
  // Evaluated rank & profit outcomes at checkpoints
  rankBefore          Int?
  rank6h              Int?
  rank12h             Int?
  rank24h             Int?
  rank3d              Int?
  rank7d              Int?
  
  status              String   @default("IN_PROGRESS") // "IN_PROGRESS", "COMPLETED", "ANOMALY"
  findings            String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([monitoredProductId, appliedAt])
}

/// SP-API Sales and Traffic Report daily sync table
/// Holds exact unit and revenue data downloaded via GET_SALES_AND_TRAFFIC_REPORT
model AmazonDailySales {
  id                  String   @id @default(cuid())
  monitoredProductId  String
  sku                 String
  asin                String
  date                String   // YYYY-MM-DD
  unitsOrdered        Int      // Exact units from Amazon
  orderedProductSales Float    // Exact revenue from Amazon

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  monitoredProduct    MonitoredProduct @relation(fields: [monitoredProductId], references: [id], onDelete: Cascade)

  @@unique([sku, date])
  @@index([monitoredProductId])
  @@index([asin])
  @@index([date])
}

model InfoProduct {
  id          String   @id @default(cuid())
  slug        String   @unique // The "1", "2", "3" identifier
  name        String
  tagline     String?
  description String?  @db.Text
  features    Json?    // Array of feature objects: { title, description, icon }
  mediaUrls   String[] // Array of image/video URLs
  actionUrl   String?  // Link for the call-to-action button
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


