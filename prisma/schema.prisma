// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  engineType    = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  OWNER
  ADMIN
  SALES
  OPS
  SUPPORT
  READONLY
}

enum QuoteStatus {
  DRAFT
  NEW
  NEEDS_INFO
  PRICING
  SENT
  APPROVED
  REJECTED
  EXPIRED
  ORDERED
  // Legacy statuses for backward compatibility
  SUBMITTED
  IN_REVIEW
  ACCEPTED
}

enum OrderStatus {
  PENDING_DEPOSIT
  IN_PRODUCTION
  QA
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String? // hashed
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(CUSTOMER)
  isActive      Boolean   @default(true)
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  quotesCreated    Quote[]       @relation("QuoteCreator")
  ordersCreated    Order[]        @relation("OrderCreator")
  messages         Message[]
  quoteMessages    QuoteMessage[] @relation("QuoteMessageSender")
  invoices         Invoice[]
  auditLogs        AuditLog[]
  accounts         Account[]
  sessions         Session[]

  @@index([companyId])
  @@index([email])
  @@index([role])
  @@index([isActive])
}

model Company {
  id              String   @id @default(cuid())
  name            String
  address         String?
  city            String?
  state           String?
  country         String?
  postalCode      String?
  phone           String?
  website         String?
  taxId           String?
  billingAddress  String?  @db.Text
  shippingAddress String?  @db.Text
  notes           String?  @db.Text
  tags            String[] // For categorization
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  quotes          Quote[]
  orders          Order[]
  invoices        Invoice[]
  contacts        ClientContact[]

  @@index([name])
}

model ClientContact {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  email       String
  phone       String?
  roleTitle   String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotes      Quote[]  @relation("QuoteContact")

  @@index([companyId])
  @@index([email])
}

model Quote {
  id                String        @id @default(cuid())
  quoteNumber       String        @unique // Human-readable: QUOTE-2024-001
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId         String?       // Primary contact
  contact           ClientContact? @relation("QuoteContact", fields: [contactId], references: [id], onDelete: SetNull)
  createdById       String
  createdBy         User           @relation("QuoteCreator", fields: [createdById], references: [id])
  status            QuoteStatus   @default(NEW)
  
  // Form fields
  productCategory   String?
  productDescription String?
  targetCustomer    String?
  packagingType     String?
  labelingNeeds     String[] // JSON array
  estimatedQuantity String? // range like "1000-5000"
  targetUnitCost    Float?
  timeline          String?
  deadline          DateTime?
  targetDueDate     DateTime?     // Admin-set target
  shippingDestination String?
  
  // Flexible JSON data
  formData          Json? // For additional fields
  notesFromClient   String?        @db.Text
  internalNotes     String?       @db.Text // Admin-only
  
  // Admin response
  adminNotes        String?        @db.Text
  totalEstimate     Float?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  attachments       QuoteAttachment[]
  lineItems         QuoteLineItem[]
  messages          Message[]
  quoteMessages     QuoteMessage[]
  orders            Order[]

  @@index([companyId])
  @@index([createdById])
  @@index([status])
  @@index([quoteNumber])
  @@index([contactId])
}

model QuoteMessage {
  id            String   @id @default(cuid())
  quoteId       String
  quote         Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  senderType    String   // "ADMIN" | "CLIENT"
  senderUserId  String?  // If admin sent it
  senderUser    User?    @relation("QuoteMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  senderContactId String? // If client contact sent it
  message       String   @db.Text
  createdAt     DateTime @default(now())

  @@index([quoteId])
  @@index([senderUserId])
}

model QuoteAttachment {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  uploadedAt  DateTime @default(now())

  @@index([quoteId])
}

model QuoteLineItem {
  id            String   @id @default(cuid())
  quoteId       String
  quote         Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  listingId     String?  // Reference to Listing if from catalog
  listing       Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  variantId     String?  // Reference to ListingVariant
  variant       ListingVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  customTitle   String?  // If not from catalog
  description   String   // Fallback if no listing
  quantity      Int
  specs         Json?    // Flexible specs JSONB
  unitPrice     Float?
  lineTotal     Float?   // quantity * unitPrice
  totalPrice    Float?   // Legacy alias
  internalCost  Float?   // Admin-only cost tracking
  margin        Float?   // Calculated margin percentage
  notes         String?
  createdAt     DateTime @default(now())

  @@index([quoteId])
  @@index([listingId])
  @@index([variantId])
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique // Human-readable: ORD-2024-001
  quoteId           String?     @unique // One-to-one: quote can only convert to one order
  quote             Quote?      @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  companyId         String
  company           Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById       String
  createdBy         User         @relation("OrderCreator", fields: [createdById], references: [id])
  status            OrderStatus  @default(PENDING_DEPOSIT)
  
  // Shipping
  shippingAddress   String?
  shippingCity      String?
  shippingState     String?
  shippingCountry   String?
  shippingPostalCode String?
  trackingNumber    String?
  
  // Financial
  subtotal          Float       @default(0)
  tax               Float       @default(0)
  shipping          Float       @default(0)
  total             Float       @default(0)
  depositPaid       Float       @default(0)
  balanceDue        Float       @default(0)
  
  // Dates
  estimatedShipDate DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  items             OrderItem[]
  messages          Message[]
  invoices          Invoice[]

  @@index([companyId])
  @@index([createdById])
  @@index([status])
  @@index([quoteId])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku           String?
  name          String
  description   String?
  quantity      Int
  unitPrice     Float
  totalPrice    Float
  packagingSpec String? // JSON
  createdAt     DateTime @default(now())

  @@index([orderId])
}

model Message {
  id          String   @id @default(cuid())
  quoteId     String?
  quote       Quote?   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     String
  isInternal  Boolean  @default(false) // Admin-only notes
  createdAt   DateTime @default(now())

  attachments Attachment[]

  @@index([quoteId])
  @@index([orderId])
  @@index([userId])
}

model Attachment {
  id          String   @id @default(cuid())
  messageId   String
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  uploadedAt  DateTime @default(now())

  @@index([messageId])
}

model Invoice {
  id                    String        @id @default(cuid())
  orderId               String?
  order                 Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  companyId             String
  company               Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById           String
  createdBy             User          @relation(fields: [createdById], references: [id])
  invoiceNumber         String        @unique
  status                InvoiceStatus @default(DRAFT)
  amount                Float
  tax                   Float         @default(0)
  total                 Float
  dueDate               DateTime?
  paidAt                DateTime?
  stripePaymentIntentId String?
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([orderId])
  @@index([companyId])
  @@index([status])
  @@index([invoiceNumber])
}

model Brand {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  parentId    String?
  parent      Brand?   @relation("BrandParent", fields: [parentId], references: [id])
  children    Brand[]  @relation("BrandParent")
  heroImage   String?
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]

  @@index([slug])
  @@index([parentId])
}

model Product {
  id            String   @id @default(cuid())
  brandId       String
  brand         Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name          String
  bullets       String[] @default([])
  imageUrl      String?
  amazonUrl     String
  asin          String   @unique
  priceAmount   Float?
  priceCurrency String?  @default("USD")
  rating        Float?
  reviewCount   Int?
  lastSyncedAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([brandId])
  @@index([asin])
}

// Admin-managed product listings (separate from Brand products)
enum ListingStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  parentId    String?
  parent      Category? @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryParent")
  description String?  @db.Text
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listings    Listing[]

  @@index([slug])
  @@index([parentId])
}

model Listing {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  description   String?       @db.Text
  status        ListingStatus @default(DRAFT)
  categoryId    String?
  category      Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand         String?       // Brand name if applicable
  moq           Int?          // Minimum order quantity
  leadTimeDays  Int?          // Lead time in days
  basePrice     Float?        // Base price
  pricingModel  String?       // "unit", "tiered", "custom"
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  variants      ListingVariant[]
  media         ListingMedia[]
  quoteLineItems QuoteLineItem[]

  @@index([slug])
  @@index([status])
  @@index([categoryId])
}

model ListingVariant {
  id            String   @id @default(cuid())
  listingId     String
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sku           String
  option1Name   String?  // e.g., "Size"
  option1Value  String?  // e.g., "Large"
  option2Name   String?  // e.g., "Color"
  option2Value  String?  // e.g., "Blue"
  cost          Float?   // Internal cost
  price         Float?   // Customer-facing price
  moq           Int?     // Variant-specific MOQ
  leadTimeDays  Int?     // Variant-specific lead time
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  quoteLineItems QuoteLineItem[]

  @@index([listingId])
  @@index([sku])
}

model ListingMedia {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url         String
  alt         String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([listingId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String   // "status_change", "created", "updated", "deleted", "pricing_edited", "role_changed"
  entityType  String   // "Quote", "Order", "Invoice", "Listing", "User", etc.
  entityId    String
  before      Json?    // Before state (JSONB)
  after       Json?    // After state (JSONB)
  ip          String?
  userAgent   String?
  metadata    Json?    // Additional context
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@index([action])
}

// NextAuth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

