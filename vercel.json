{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "rm -rf node_modules/.prisma && npm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/admin/inventory/sync",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/admin/autopricer/sync-sales",
      "schedule": "5 7 * * *"
    },
    {
      "path": "/api/admin/autopricer/cron/daily-analysis",
      "schedule": "10 7 * * *"
    },
    {
      "path": "/api/admin/autopricer/cron/daily",
      "schedule": "15 7 * * *"
    }
  ]
}
