{
  "buildCommand": "rm -rf .next && npx prisma generate && next build",
  "devCommand": "npm run dev",
  "installCommand": "rm -rf node_modules/.prisma && npm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/admin/inventory/sync",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/admin/autopricer/sync-sales",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/admin/autopricer/cron/daily-analysis",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/admin/autopricer/cron/execute-scheduled",
      "schedule": "0 8 * * *"
    }
  ]
}
